# ==============================================================================
# Occupify Administration Service Environment Variables
# ==============================================================================

# Server
SERVER_PORT=8185

# PostgreSQL Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5534
POSTGRES_DB=occupify_administration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DB_URL=jdbc:postgresql://${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# Dev Mock Authentication (Set false when running behind occupify-gateway)
DEV_MOCK_AUTH_ENABLED=true
